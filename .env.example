PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database: Uses local SQLite by default, or connects to Turso when credentials provided
TURSO_DATABASE_URL=file:./trendly.db
TURSO_AUTH_TOKEN=

# AI Trend Generation & Co-Pilot (OpenRouter - free tier available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Image Sourcing: Live Unsplash Photo Search (Free demo key at unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Automation: Daily scheduled trend refresh (cron format)
CRON_SCHEDULE=0 9 * * *
